# Copy to .env and fill in your own values. Never commit .env.

# Zetaris (local Docker)
ZETARIS_API_KEY=
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_MOCK=1

# Meterless Nightshift (copy from Nightshift > Console)
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=

# Postgres (infra/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ledger_lens
POSTGRES_USER=ledger
POSTGRES_PASSWORD=

# Backend
PORT=3000

# Web (Vite reads VITE_* vars)
VITE_API_URL=http://localhost:3000
VITE_USE_MOCKS=true

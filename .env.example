# Copy to .env and fill in your own values. Never commit .env.

# Zetaris (local Docker)
ZETARIS_API_KEY=
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_MOCK=1

# Meterless Nightshift (copy from Nightshift > Console)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Postgres (infra/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ledger_lens
POSTGRES_USER=ledger
POSTGRES_PASSWORD=

# Backend
PORT=4000

# Web (Vite reads VITE_* vars)
VITE_API_URL=http://localhost:4000
VITE_USE_MOCKS=true

# Copy to .env and fill in your own values. Never commit .env.
# Docker (root docker-compose.yml): this file is optional. The app container
# reaches Nightshift and Zetaris on the host via host.docker.internal; override
# with DOCKER_METERLESS_BASE_URL / DOCKER_ZETARIS_REST_URL if they live elsewhere.

# Zetaris (local Docker)
ZETARIS_API_KEY=
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# 1 = serve the four views from backend/src/zetaris/mock/*.json (no Zetaris needed)
ZETARIS_MOCK=1
# SchemaStore container and datasource created by zetaris/setup_zetaris.sh
ZETARIS_VIEW_SCHEMA=ledger_lens
ZETARIS_PG_DATASOURCE=ledger_lens_pg
# Persona B (I6, optional): ZETARIS_VIEW_SCHEMA=ledger_lens_b and
# ZETARIS_MOCK_DIR=backend/src/zetaris/mock/b. Leave empty for persona A.
ZETARIS_MOCK_DIR=
# Host as seen from inside the Zetaris containers. Leave empty to auto-detect;
# set it to host.docker.internal or your Linux docker-bridge/LAN IP if needed.
ZETARIS_PG_HOST=
ZETARIS_QUERY_LIMIT=1000
ZETARIS_TIMEOUT_MS=120000

# Meterless Nightshift (copy from Nightshift > Console)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Postgres (infra/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ledger_lens
POSTGRES_USER=ledger
POSTGRES_PASSWORD=

# Backend
PORT=4000
# Demo only: 1 = put one invented amount in the Explainer's first answer so the G1 critic
# visibly catches it and the model revises. The trace marks it "injected by DEMO_CRITIC".
DEMO_CRITIC=0

# Web: Vite reads VITE_* vars from web/.env (copy web/.env.example), not from this file.
# The defaults (API on http://localhost:4000, live API) need no web/.env at all.
